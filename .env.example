# ==============================================================================
# Enterprise BI Platform - Environment Variables Template
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# PostgreSQL Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=bi_admin
DB_PASSWORD=SecureMasterPassword2026!
DB_NAME=enterprise_bi_db
DATABASE_URL=postgresql://bi_admin:SecureMasterPassword2026!@postgres:5432/enterprise_bi_db

# Security & Authentication
JWT_SECRET=super_secret_enterprise_jwt_key_2026_modern_bi_platform_key!
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_key_2026_enterprise_platform!
JWT_REFRESH_EXPIRES_IN=30d

# DuckDB Analytics Engine & Storage
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4
STORAGE_BASE_PATH=/app/storage
PARQUET_CACHE_PATH=/app/storage/parquet_cache

# MinIO / S3 Object Storage
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minio_bi_admin
S3_SECRET_KEY=MinioSecretPassword2026!
S3_BUCKET_NAME=bi-data-storage

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000/api/v1
FRONTEND_PORT=80
BACKEND_PORT=3000

# Rate Limiting & Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=120
